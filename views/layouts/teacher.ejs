<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Edura - لوحة المدرس</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a5f',
                        primaryLight: '#2a4f7f',
                        primaryDark: '#152a45',
                        accent: '#f59e0b',
                        accentLight: '#fbbf24',
                        accentDark: '#d97706'
                    },
                    fontFamily: {
                        tajawal: ['Tajawal', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="font-tajawal bg-gray-100">
    <%- include('../partials/toast') %>
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside id="teacherSidebar" class="fixed inset-y-0 right-0 z-50 w-64 bg-primary text-white transform transition-transform duration-300 lg:translate-x-0 lg:static lg:inset-auto">
            <div class="flex items-center justify-between p-4 border-b border-primaryLight">
                <a href="/teacher/dashboard" class="text-xl font-bold flex items-center gap-2">
                    <img src="/images/edura_logo_icon.svg" alt="Edura" class="w-16 h-auto rounded-full">
                    <span>Edura</span>
                </a>
                <button id="closeSidebar" class="lg:hidden text-white hover:text-accent">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <nav class="p-4 space-y-1">
                <a href="/teacher/dashboard" class="sidebar-link <%= title === 'لوحة المدرس' ? 'active' : '' %>">
                    <i class="fas fa-chart-line w-5"></i>
                    <span>لوحة المدرس</span>
                </a>
                <a href="/teacher/courses" class="sidebar-link <%= title === 'كورساتي' ? 'active' : '' %>">
                    <i class="fas fa-book w-5"></i>
                    <span>كورساتي</span>
                </a>
                <a href="/teacher/categories" class="sidebar-link <%= title === 'التصنيفات' ? 'active' : '' %>">
                    <i class="fas fa-tags w-5"></i>
                    <span>التصنيفات</span>
                </a>
                <a href="/teacher/discount-codes" class="sidebar-link <%= title === 'أكواد الخصم' ? 'active' : '' %>">
                    <i class="fas fa-percent w-5"></i>
                    <span>أكواد الخصم</span>
                </a>
                <a href="/teacher/profile" class="sidebar-link <%= title === 'الملف الشخصي' ? 'active' : '' %>">
                    <i class="fas fa-user-circle w-5"></i>
                    <span>الملف الشخصي</span>
                </a>
            </nav>

            <div class="absolute bottom-0 right-0 left-0 p-4 border-t border-primaryLight">
                <a href="/" class="sidebar-link">
                    <i class="fas fa-home w-5"></i>
                    <span>الموقع الرئيسي</span>
                </a>
                <a href="/logout" class="sidebar-link text-red-300 hover:text-red-200">
                    <i class="fas fa-sign-out-alt w-5"></i>
                    <span>تسجيل الخروج</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <!-- Top bar -->
            <header class="bg-white shadow-sm px-6 py-4 flex items-center justify-between">
                <button id="openSidebar" class="lg:hidden text-primary hover:text-accent">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <h1 class="text-xl font-bold text-primary"><%= title %></h1>
                <div class="flex items-center gap-4">
                    <span class="text-gray-600"><%= user ? user.fullName : '' %></span>
                    <a href="/teacher/profile" class="block" title="الملف الشخصي">
                        <img src="<%= user && user.profileImage ? user.profileImage : '/images/default-avatar.svg' %>"
                             alt="<%= user ? user.fullName : 'المدرس' %>"
                             class="w-10 h-10 rounded-full object-cover border-2 border-primary/10">
                    </a>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 p-6 overflow-auto">
                
         
