<%- include('../../layouts/teacher') %>

<div class="mb-6 rounded-2xl bg-gradient-to-l from-primaryDark via-primary to-primaryLight p-6 text-white shadow-lg">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
            <img src="<%= teacher && teacher.profileImage ? teacher.profileImage : '/images/default-avatar.svg' %>"
                 alt="<%= teacher ? teacher.fullName : 'المدرس' %>"
                 class="h-20 w-20 rounded-2xl object-cover ring-4 ring-white/20">
            <div>
                <p class="text-sm text-blue-100">مرحباً بعودتك</p>
                <h2 class="mt-1 text-2xl font-bold"><%= teacher ? teacher.fullName : user.fullName %></h2>
                <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100">
                    <%= teacher && teacher.bio ? teacher.bio : 'أضف نبذة تعريفية وخبراتك في صفحة ملفك الشخصي.' %>
                </p>
            </div>
        </div>
        <a href="/teacher/profile" class="btn-outline shrink-0 border-white/30 bg-white/10 text-white hover:bg-white hover:text-primary">
            <i class="fas fa-user-edit"></i> تعديل الملف
        </a>
    </div>
</div>

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-8">
    <a href="/teacher/courses" class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-primary/30 hover:shadow-md">
        <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-book text-xl"></i>
            </div>
            <span class="text-3xl font-black text-primary"><%= stats.totalCourses %></span>
        </div>
        <h3 class="mt-5 font-bold text-primary">إجمالي الكورسات</h3>
        <p class="mt-1 text-sm text-gray-500">إدارة جميع الكورسات الخاصة بك</p>
    </a>

    <a href="/teacher/courses" class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-md">
        <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-100 text-green-600">
                <i class="fas fa-circle-check text-xl"></i>
            </div>
            <span class="text-3xl font-black text-green-600"><%= stats.availableCourses %></span>
        </div>
        <h3 class="mt-5 font-bold text-primary">الكورسات المتاحة</h3>
        <p class="mt-1 text-sm text-gray-500">الكورسات المنشورة للعملاء</p>
    </a>

    <a href="/teacher/discount-codes" class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-md">
        <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/20 text-accent">
                <i class="fas fa-percent text-xl"></i>
            </div>
            <span class="text-3xl font-black text-accent"><%= stats.discountCodes %></span>
        </div>
        <h3 class="mt-5 font-bold text-primary">أكواد الخصم</h3>
        <p class="mt-1 text-sm text-gray-500">إدارة العروض الخاصة بكورساتك</p>
    </a>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="mb-5 text-lg font-bold text-primary">
            <i class="fas fa-bolt ml-2 text-accent"></i> إجراءات سريعة
        </h3>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <a href="/teacher/courses" class="flex items-center gap-4 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50">
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary text-white"><i class="fas fa-plus"></i></span>
                <span><strong class="block text-primary">إضافة أو تعديل كورس</strong><small class="text-gray-500">إدارة محتوى الدورات</small></span>
            </a>
            <a href="/teacher/profile" class="flex items-center gap-4 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50">
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-100 text-blue-600"><i class="fas fa-id-card"></i></span>
                <span><strong class="block text-primary">تحديث الملف الشخصي</strong><small class="text-gray-500">الصورة والنبذة والبيانات</small></span>
            </a>
            <a href="/teacher/categories" class="flex items-center gap-4 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50">
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-purple-100 text-purple-600"><i class="fas fa-tags"></i></span>
                <span><strong class="block text-primary">التصنيفات</strong><small class="text-gray-500">تنظيم تصنيفات الكورسات</small></span>
            </a>
            <a href="/teacher/discount-codes" class="flex items-center gap-4 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50">
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent/20 text-accent"><i class="fas fa-percent"></i></span>
                <span><strong class="block text-primary">إنشاء كود خصم</strong><small class="text-gray-500">إضافة عروض جديدة</small></span>
            </a>
        </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="mb-5 text-lg font-bold text-primary">
            <i class="fas fa-compass ml-2 text-accent"></i> وصول مباشر
        </h3>
        <div class="space-y-3">
            <a href="/" class="flex items-center justify-between rounded-lg bg-gray-50 p-4 text-primary transition hover:bg-primary hover:text-white">
                <span><i class="fas fa-home ml-2"></i> عرض الموقع</span><i class="fas fa-arrow-left text-xs"></i>
            </a>
            <a href="/teacher/courses" class="flex items-center justify-between rounded-lg bg-gray-50 p-4 text-primary transition hover:bg-primary hover:text-white">
                <span><i class="fas fa-book ml-2"></i> كورساتي</span><i class="fas fa-arrow-left text-xs"></i>
            </a>
            <a href="/logout" class="flex items-center justify-between rounded-lg bg-red-50 p-4 text-red-600 transition hover:bg-red-600 hover:text-white">
                <span><i class="fas fa-right-from-bracket ml-2"></i> تسجيل الخروج</span><i class="fas fa-arrow-left text-xs"></i>
            </a>
        </div>
    </div>
</div>

   </main>
        </div>
    </div>

    <script src="/js/admin.js"></script>
</body>
</html>
