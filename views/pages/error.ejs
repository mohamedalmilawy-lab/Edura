<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خطأ | Edura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a5f',
                        accent: '#f59e0b'
                    },
                    fontFamily: {
                        tajawal: ['Tajawal', 'sans-serif']
                    }
                }
            }
        }
    </script>
</head>
<body class="font-tajawal bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="text-center px-4">
        <div class="mb-6">
            <i class="fas fa-exclamation-circle text-8xl text-red-500 mb-4"></i>
            <h1 class="text-4xl font-black text-primary mb-2">حدث خطأ</h1>
            <p class="text-gray-500 max-w-md mx-auto"><%= message %></p>
        </div>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/login" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-primary/90 transition-colors">
                <i class="fas fa-sign-in-alt"></i> تسجيل الدخول للوحة التحكم
            </a>
        </div>
    </div>
</body>
</html>
