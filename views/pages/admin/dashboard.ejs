<%- include('../../layouts/admin') %>
<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="stat-card-admin">
        <div class="stat-icon bg-primary/10 text-primary">
            <i class="fas fa-book"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-primary"><%= stats.totalCourses %></p>
            <p class="text-gray-500 text-sm">إجمالي الكورسات</p>
        </div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-icon bg-blue-100 text-blue-600">
            <i class="fas fa-users"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-primary"><%= stats.totalUsers %></p>
            <p class="text-gray-500 text-sm">إجمالي المستخدمين</p>
        </div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-icon bg-accent/20 text-accent">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-primary"><%= stats.totalOrders %></p>
            <p class="text-gray-500 text-sm">إجمالي الطلبات</p>
        </div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-icon bg-green-100 text-green-600">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-primary"><%= stats.revenue %> ل.س </p>
            <p class="text-gray-500 text-sm">إجمالي الإيرادات</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Sales by Category Chart -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-bold text-primary mb-4">
            <i class="fas fa-chart-bar text-accent ml-1"></i> الكورسات المباعة حسب التصنيف
        </h3>
        <div class="chart-container">
            <canvas id="salesChart"></canvas>
        </div>
        <% if (categoryStats.length > 0) { %>
            <script>
                window.categoryChartData = <%- JSON.stringify(categoryStats) %>;
            </script>
        <% } else { %>
            <div class="flex items-center justify-center h-full text-gray-400">
                <p>لا توجد بيانات كافية</p>
            </div>
        <% } %>
    </div>

    <!-- Quick Stats -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-bold text-primary mb-4">
            <i class="fas fa-chart-pie text-accent ml-1"></i> إحصائيات سريعة
        </h3>
        <div class="space-y-4">
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center">
                        <i class="fas fa-envelope text-yellow-600"></i>
                    </div>
                    <span class="font-semibold">رسائل التواصل</span>
                </div>
                <span class="text-2xl font-bold text-primary"><%= stats.recentContacts %></span>
            </div>
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
                        <i class="fas fa-comments text-purple-600"></i>
                    </div>
                    <span class="font-semibold">التعليقات</span>
                </div>
                <span class="text-2xl font-bold text-primary"><%= stats.recentComments %></span>
            </div>
        </div>
    </div>
</div>

<!-- Latest Orders -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-bold text-primary">
            <i class="fas fa-clock text-accent ml-1"></i> أحدث الطلبات
        </h3>
        <a href="/admin/orders" class="text-sm text-primary hover:text-accent font-semibold">عرض الكل</a>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>رقم الطلب</th>
                    <th>العميل</th>
                    <th>الكورسات</th>
                    <th>السعر</th>
                    <th>التاريخ</th>
                </tr>
            </thead>
            <tbody>
                <% if (latestOrders.length > 0) { %>
                    <% latestOrders.forEach(function(order) { %>
                        <tr>
                            <td class="font-semibold text-primary"><%= order.orderNumber %></td>
                            <td><%= order.user ? order.user.fullName : 'مجهول' %></td>
                            <td>
                                <% order.courses.forEach(function(c, i) { %>
                                    <span class="text-xs bg-gray-100 px-2 py-1 rounded"><%= c.title %></span>
                                    <% if (i < order.courses.length - 1) { %> <% } %>
                                <% }); %>
                            </td>
                            <td class="font-bold text-accent"><%= order.totalPrice %> ل.س</td>
                            <td class="text-gray-400 text-sm"><%= new Date(order.createdAt).toLocaleDateString('ar-SA') %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center text-gray-400 py-8">لا توجد طلبات بعد</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
   </main>
        </div>
    </div>

    <script src="/js/admin.js"></script>
</body>
</html>
